{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "PowerShell Launch Current File",
			"type": "PowerShell",
			"request": "launch",
			"script": "${file}",
			"cwd": "${cwd}"
		},
		{
			"name": "Open Debug Session",
			"type": "PowerShell",
			"request": "launch",
			"script": ". \"${workspaceFolder}${/}build${/}Deploy-Application.ps1\" -SkipDeployment"
		}
	]
}
