<?xml version="1.0" encoding="utf-8"?>
<!-- *******************************************************************
This file is part of the PowerShell App Deployment Toolkit Neo42 Extensions module.
It is used to define custom types and their members for PowerShell objects.
******************************************************************** -->
<Types xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PowerShell/PowerShell/refs/heads/master/src/Schemas/Types.xsd">
	<Type>
		<Name>System.Diagnostics.Process</Name>
		<Members>
			<ScriptMethod>
				<Name>GetParent</Name>
				<Script>
					try { [PSADT.ProcessManagement.ProcessUtilities]::GetParentProcess($this) } catch { $null }
				</Script>
			</ScriptMethod>
			<ScriptMethod>
				<Name>GetChildren</Name>
				<Script>
					[PSADTNXT.Extensions.NxtProcessExtensions]::GetChildProcesses($this)
				</Script>
			</ScriptMethod>
			<ScriptProperty>
				<Name>IsElevated</Name>
				<GetScriptBlock>
					[PSADTNXT.Extensions.NxtProcessExtensions]::IsElevated($this)
				</GetScriptBlock>
			</ScriptProperty>
		</Members>
	</Type>
	<Type>
		<Name>PSADT.Types.InstalledApplication</Name>
		<Members>
			<ScriptMethod>
				<Name>GetRegisteredPackage</Name>
				<Script>
					$package = $null
					if ([PSADTNXT.Package.NxtRegisteredPackage]::TryGetPackage($this, [ref]$package)) { $package }
				</Script>
			</ScriptMethod>
			<ScriptProperty>
				<Name>UpgradeCode</Name>
				<GetScriptBlock>
					if ($this.WindowsInstaller -and $this.ProductCode) { [PSADTNXT.Extensions.NxtPsadtExtensions]::GetUpgradeCode($this.ProductCode).ToString("B") }
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>InnoSetupInstaller</Name>
				<GetScriptBlock>
					[PSADTNXT.Extensions.NxtPsadtExtensions]::IsNullSoftInstaller($this)
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>BurnInstaller</Name>
				<GetScriptBlock>
					[PSADTNXT.Extensions.NxtPsadtExtensions]::IsBurnInstaller($this)
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>Store</Name>
				<GetScriptBlock>
					[PSADTNXT.Extensions.NxtPsadtExtensions]::GetApplicationStore($this)
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptMethod>
				<Name>Unhide</Name>
				<Script>
					if ($this.PSParentPath -like '*\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall' -and ([Microsoft.Win32.RegistryKey]$key = [PSADTNXT.Shell.NxtPowerShell]::ToRegistryKeyFromPSProviderPath($this.PSPath, $true))) {
						$key.DeleteValue('SystemComponent', $false)
					}
					else {
						Write-ADTLogEntry -Severity Warning -Message "Cannot hide application [$this]. It either does not exist or is not an ARP application."
					}
				</Script>
			</ScriptMethod>
			<ScriptMethod>
				<Name>Hide</Name>
				<Script>
					if ($this.PSParentPath -like '*\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall' -and ([Microsoft.Win32.RegistryKey]$key = [PSADTNXT.Shell.NxtPowerShell]::ToRegistryKeyFromPSProviderPath($this.PSPath, $true))) {
						$key.SetValue('SystemComponent', 1, [Microsoft.Win32.RegistryValueKind]::DWord)
					}
					else {
						Write-ADTLogEntry -Severity Warning -Message "Cannot hide application [$this]. It either does not exist or is not an ARP application."
					}
				</Script>
			</ScriptMethod>
		</Members>
	</Type>
	<Type>
		<Name>System.String</Name>
		<Members>
			<ScriptMethod>
				<Name>Expand</Name>
				<Script>
					$ExecutionContext.InvokeCommand.ExpandString($this)
				</Script>
			</ScriptMethod>
		</Members>
	</Type>
</Types>
