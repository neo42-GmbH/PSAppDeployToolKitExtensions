		</policy>
		<policy name="NxtDeploymentBitRockInstallerSilentParams" class="Machine" displayName="$(string.NxtDeploymentSilentParams_Display)" explainText="$(string.NxtDeploymentSilentParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\BitRockInstaller" presentation="$(presentation.NxtDeploymentBitRockInstallerSilentParams)">
			<parentCategory ref="NxtDeploymentBitRockInstaller" />
