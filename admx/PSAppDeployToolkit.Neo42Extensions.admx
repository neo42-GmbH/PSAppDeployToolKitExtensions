		</policy>
		<policy name="NxtDeploymentNullsoftUninstallParams" class="Machine" displayName="$(string.NxtDeploymentUninstallParams_Display)" explainText="$(string.NxtDeploymentUninstallParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\Nullsoft" presentation="$(presentation.NxtDeploymentNullsoftUninstallParams)">
			<parentCategory ref="NxtDeploymentNullsoft" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
				<text id="UninstallParams" valueName="UninstallParams"/>
			</elements>
		</policy>

		<policy name="NxtDeploymentBitRockInstallerInstallParams" class="Machine" displayName="$(string.NxtDeploymentInstallParams_Display)" explainText="$(string.NxtDeploymentInstallParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\BitRockInstaller" presentation="$(presentation.NxtDeploymentBitRockInstallerInstallParams)">
			<parentCategory ref="NxtDeploymentBitRockInstaller" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
