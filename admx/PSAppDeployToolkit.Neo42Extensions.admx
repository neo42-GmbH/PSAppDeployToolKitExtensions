		<policy name="NxtDeploymentAppxSilentParams" class="Machine" displayName="$(string.NxtDeploymentSilentParams_Display)" explainText="$(string.NxtDeploymentSilentParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\Appx" presentation="$(presentation.NxtDeploymentAppxSilentParams)">
