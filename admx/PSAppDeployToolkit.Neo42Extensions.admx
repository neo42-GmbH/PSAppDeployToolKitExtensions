		<policy name="NxtDeploymentInnoSetupSilentParams" class="Machine" displayName="$(string.NxtDeploymentSilentParams_Display)" explainText="$(string.NxtDeploymentSilentParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\InnoSetup" presentation="$(presentation.NxtDeploymentInnoSetupSilentParams)">
			<parentCategory ref="NxtDeploymentInnoSetup" />
