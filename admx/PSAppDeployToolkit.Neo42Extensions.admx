		</policy>

		<policy name="NxtDeploymentBurnInstallParams" class="Machine" displayName="$(string.NxtDeploymentInstallParams_Display)" explainText="$(string.NxtDeploymentInstallParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\Burn" presentation="$(presentation.NxtDeploymentBurnInstallParams)">
			<parentCategory ref="NxtDeploymentBurn" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
				<text id="InstallParams" valueName="InstallParams" />
			</elements>
		</policy>
		<policy name="NxtDeploymentBurnSilentParams" class="Machine" displayName="$(string.NxtDeploymentSilentParams_Display)" explainText="$(string.NxtDeploymentSilentParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\Burn" presentation="$(presentation.NxtDeploymentBurnSilentParams)">
			<parentCategory ref="NxtDeploymentBurn" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
				<text id="SilentParams" valueName="SilentParams" />
			</elements>
		</policy>
		<policy name="NxtDeploymentBurnUninstallParams" class="Machine" displayName="$(string.NxtDeploymentUninstallParams_Display)" explainText="$(string.NxtDeploymentUninstallParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\Burn" presentation="$(presentation.NxtDeploymentBurnUninstallParams)">
			<parentCategory ref="NxtDeploymentBurn" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
				<text id="UninstallParams" valueName="UninstallParams" />
			</elements>
		</policy>

		<policy name="NxtDeploymentAppxInstallParams" class="Machine" displayName="$(string.NxtDeploymentInstallParams_Display)" explainText="$(string.NxtDeploymentInstallParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\Appx" presentation="$(presentation.NxtDeploymentAppxInstallParams)">
			<parentCategory ref="NxtDeploymentAppx" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
				<text id="InstallParams" valueName="InstallParams" />
