		<policy name="NxtDeploymentInnoSetupUninstallParams" class="Machine" displayName="$(string.NxtDeploymentUninstallParams_Display)" explainText="$(string.NxtDeploymentUninstallParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\InnoSetup" presentation="$(presentation.NxtDeploymentInnoSetupUninstallParams)">
			<parentCategory ref="NxtDeploymentInnoSetup" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
				<text id="UninstallParams" valueName="UninstallParams"/>
			</elements>
		</policy>

		<policy name="NxtDeploymentNullsoftInstallParams" class="Machine" displayName="$(string.NxtDeploymentInstallParams_Display)" explainText="$(string.NxtDeploymentInstallParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\Nullsoft" presentation="$(presentation.NxtDeploymentNullsoftInstallParams)">
			<parentCategory ref="NxtDeploymentNullsoft" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
				<text id="InstallParams" valueName="InstallParams"/>
			</elements>
		</policy>
		<policy name="NxtDeploymentNullsoftSilentParams" class="Machine" displayName="$(string.NxtDeploymentSilentParams_Display)" explainText="$(string.NxtDeploymentSilentParams_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\Deployment\Nullsoft" presentation="$(presentation.NxtDeploymentNullsoftSilentParams)">
			<parentCategory ref="NxtDeploymentNullsoft" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
				<text id="SilentParams" valueName="SilentParams"/>
