		<policy name="NxtSetupCfgOverrideValues" class="Machine" displayName="$(string.NxtSetupCfgOverrideValues_Display)" explainText="$(string.NxtSetupCfgOverrideValues_Explain)" key="SOFTWARE\Policies\PSAppDeployToolkit\Config\NXT\SetupCfg\Overrides" presentation="$(presentation.NxtSetupCfgOverrideValues)">
			<parentCategory ref="NxtSetupCfg" />
			<supportedOn ref="SUPPORTED_Windows_10_0_RS1" />
			<elements>
				<list id="Overrides" />
			</elements>
